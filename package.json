{
  "name": "dsh-achievements",
  "version": "0.2.0",
  "description": "DeepSeek Harness achievement & gamification plugin: cross-session badges for turns, tool calls, sessions and daily streaks, with a badge panel, unlock toasts and a ctx.achievements service. Zero core changes.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "achievements",
    "gamification",
    "badges"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blaczz/dsh-achievements.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.3 <0.2.0",
      "node": ">=22.19.0",
      "dshReleases": {
        "0.1.5-alpha.1": "compatible"
      }
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "docs",
    "examples"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "setup:dsh-workspace": "node scripts/setup-dsh-workspace.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "npm run typecheck:src && npm run typecheck:tests",
    "typecheck:src": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "node node_modules/typescript/bin/tsc -p tsconfig.test.json --noEmit",
    "test": "node node_modules/vitest/vitest.mjs run tests",
    "verify": "node scripts/verify.mjs",
    "prepack": "npm run clean && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <5.0.0",
    "@deepseek-ai/schemastery": ">=3.18.1-rc.1 <4.0.0",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.3 <0.2.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.3 <0.2.0",
    "@deepseek-ai/dsh-home-paths": ">=0.0.1-rc.3",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.3 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.3 <0.2.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.3 <0.2.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.3 <0.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.3 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.3 <0.2.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "@deepseek-ai/dsh-settings": { "optional": true },
    "@deepseek-ai/dsh-host-webserver": { "optional": true },
    "@deepseek-ai/dsh-home-paths": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-client-runtime": { "optional": true },
    "@deepseek-ai/dsh-client-ui-settings": { "optional": true },
    "@deepseek-ai/dsh-client-ui-primitives": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@types/react": "18.3.31",
    "js-yaml": "4.3.1",
    "react": "18.3.1",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
